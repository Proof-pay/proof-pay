# Example only. Copy to .env and replace secret values before starting Compose.
PROJECT_NAME=ProofPay
DOMAIN=localhost
SECRET_KEY=replace-with-a-long-random-secret
POSTGRES_PASSWORD=replace-with-a-strong-password
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=replace-with-a-strong-password
EMAILS_FROM_EMAIL=admin@example.com
SMTP_HOST=
SENTRY_DSN=
FRONTEND_HOST=http://localhost:5173
DATABASE_URL=postgresql://postgres:replace-with-a-strong-password@localhost:5432/app

# Read-only Bitcoin Cash Node RPC. Use txindex=1 for historical claims.
BCH_NETWORK=mainnet
BCH_RPC_URL=
BCH_RPC_USER=
BCH_RPC_PASSWORD=
BCH_REQUIRED_CONFIRMATIONS=1
BCH_RECONCILIATION_INTERVAL_SECONDS=60
PUBLIC_CHECKOUT_BASE_URL=http://localhost:5173
